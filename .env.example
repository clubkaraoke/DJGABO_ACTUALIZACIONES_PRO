# DJGABO ACTUALIZACIONES PRO — variables de entorno
# Copia este archivo a apps/api/.env y ajusta los valores.
# (El frontend no usa variables de entorno propias en dev: Vite ya proxea
# /api hacia http://localhost:4000, ver apps/web/vite.config.ts)

NODE_ENV=development
PORT=4000

# --- Base de datos ---
# Dev: SQLite (por defecto, sin instalar nada). Ver docs/STORAGE.md para
# migrar a Postgres.
DATABASE_URL="file:./data/dev.db"

# --- Autenticación ---
# Genera valores propios en producción, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="cambia-este-secreto-de-acceso-en-produccion"
JWT_REFRESH_SECRET="cambia-este-secreto-de-refresh-en-produccion"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Secreto para firmar los device tokens (punto 5). Debe ser distinto de los
# secretos JWT de sesión.
DEVICE_TOKEN_SECRET="cambia-este-secreto-de-dispositivo-en-produccion"

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Storage ---
# mock (por defecto) | dropbox
STORAGE_PROVIDER=mock

# Solo necesarias si STORAGE_PROVIDER=dropbox. Ver docs/DROPBOX_SETUP.md
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=/ACTUALIZACIONES

# Carpeta raíz que el StorageIndexerService recorre al sincronizar
SYNC_ROOT_PATH=/ACTUALIZACIONES


# Catálogo JSON público (en Railway usar /data/catalog para persistencia)
CATALOG_JSON_DIR=./data/catalog

# Opcional: espejo incremental hacia 01_MAESTRO_PORTAL_ACTUALIZACIONES_PRO
# Debe ser un Google Apps Script Web App/gateway server-side.
# SHEET_SYNC_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# SHEET_SYNC_WEBHOOK_SECRET=change-me
